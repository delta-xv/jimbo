{
  "name": "jimbo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "android:sync": "npm run build && cap sync android",
    "apk": "node scripts/build-apk.mjs",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:simulator": "node scripts/build-ios.mjs simulator",
    "ios:unsigned": "node scripts/build-ios.mjs unsigned",
    "ios:archive": "node scripts/build-ios.mjs archive",
    "notices:sync": "node scripts/sync-notices.mjs",
    "notices:check": "node scripts/sync-notices.mjs --check",
    "prebuild": "npm run notices:sync"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/preferences": "8.0.1",
    "@fontsource/vt323": "5.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "22.19.7",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.12"
  },
  "description": "A mobile-friendly, unofficial recreation of Jimbo’s Game from Dave the Diver.",
  "license": "MIT",
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
